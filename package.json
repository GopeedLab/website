{
  "name": "gopeed-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docs:generate": "node scripts/fetch-swagger.mjs && node scripts/generate-openapi.mjs",
    "prebuild": "pnpm docs:generate",
    "build": "next build",
    "build:worker": "pnpm cf:build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy --minify",
    "predev": "pnpm docs:generate",
    "dev": "next dev",
    "start": "next start",
    "types:check": "pnpm docs:generate && fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write",
    "db:migrate:dev": "wrangler d1 migrations apply --local gopeed",
    "db:migrate": "wrangler d1 migrations apply --remote gopeed",
    "db:studio:dev": "cross-env LOCAL_DB_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print0 | xargs -0 ls -t | head -1) drizzle-kit studio",
    "sync:extensions": "node scripts/sync-extensions.mjs",
    "test:store-cache": "esbuild lib/store/response-cache.test.ts --bundle --platform=node --format=cjs --outfile=.wrangler/tests/store-cache.cjs && node --test .wrangler/tests/store-cache.cjs"
  },
  "dependencies": {
    "@fumadocs/language": "0.2.16",
    "@heroicons/react": "^2.2.0",
    "@libsql/client": "^0.17.0",
    "drizzle-orm": "^0.45.1",
    "firebase": "^12.10.0",
    "framer-motion": "^11.18.2",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-openapi": "12.5.4",
    "fumadocs-ui": "16.17.7",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.5.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@opennextjs/cloudflare": "1.20.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.9",
    "esbuild": "0.25.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "4.152.0"
  }
}
